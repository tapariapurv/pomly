{
  "manifest_version": 3,
  "name": "Pomly Focus",
  "version": "1.1.0",
  "description": "Blocks distracting sites while your Pomly focus timer runs. Pairs with Pomly on iPhone, iPad, Mac and Apple Watch.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Pomly" },
  "options_page": "popup.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
